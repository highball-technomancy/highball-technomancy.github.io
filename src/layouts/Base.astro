---
// Base.astro — the shell every redesign page sits in: head, fonts, tokens,
// header, footer. Pages supply only their middle.
//
// index.astro (the live site) deliberately does NOT use this yet. It keeps its
// own standalone styles until the cutover, so nothing here can affect what is
// currently published.
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;1,300&family=IBM+Plex+Sans:wght@300;400;500&display=swap" rel="stylesheet">
</head>
<body>

  <div class="wrap"><Header /></div>

  <slot />

  <div class="wrap"><Footer /></div>

</body>
</html>
