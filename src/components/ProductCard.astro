---
// ProductCard.astro
interface Props {
  title: string;
  description: string;
  status: 'In Development' | 'Beta' | 'Live' | 'Coming Soon' | 'Alpha' | 'Design Phase';
  techStack?: string[];
  githubUrl?: string;
  docsUrl?: string;
  demoUrl?: string;
  icon?: string;
  iconImage?: string;
  glow?: 'green' | 'purple' | 'cyan' | 'pink' | 'gold' | 'orange' | 'red';
  iconSize?: 'md' | 'lg';
  iconFrame?: 'none' | 'circle';
}

const { title, description, status, techStack, githubUrl, docsUrl, demoUrl, icon, iconImage, glow = 'green', iconSize = 'md', iconFrame = 'none' } = Astro.props;

const glowClasses = {
  green: 'glow-green',
  purple: 'glow-purple',
  cyan: 'glow-cyan',
  pink: 'glow-pink',
  gold: 'glow-gold',
  orange: 'glow-orange',
  red: 'glow-red'
};

const iconSizes = {
  md: 'max-h-32',
  lg: 'max-h-32 scale-125'
};

const iconClasses = iconFrame === 'circle'
  ? 'h-32 w-32 rounded-full object-cover border border-white/10'
  : `${iconSizes[iconSize]} w-auto object-contain`;

const statusColors = {
  'In Development': 'border-neon-orange text-neon-orange',
  'Beta': 'border-neon-cyan text-neon-cyan',
  'Live': 'border-neon-green text-neon-green',
  'Coming Soon': 'border-neon-purple text-neon-purple',
  'Alpha': 'border-neon-cyan text-neon-cyan',
  'Design Phase': 'border-gray-500 text-gray-400'
};
---

<div class="product-card glass rounded-xl p-8 border border-white/10 hover:border-neon-green/50 transition-all glow-box-green">
  <!-- Status badge -->
  <div class="flex items-center justify-between mb-4">
    <span class={`text-sm px-4 py-1 rounded-full border ${statusColors[status]}`}>
      {status}
    </span>
  </div>

  <!-- Icon -->
  <div class="flex items-center justify-center h-32 mb-4">
    {iconImage && (
      <img src={iconImage} alt={`${title} icon`} class={iconClasses} />
    )}
    {!iconImage && icon && (
      <span class="text-7xl">{icon}</span>
    )}
  </div>
  
  <!-- Title -->
  <h3 class={`text-3xl font-bold mb-4 text-center ${glowClasses[glow]}`}>
    {title}
  </h3>
  
  <!-- Description -->
  <p class="text-gray-300 mb-6 text-lg leading-relaxed">
    {description}
  </p>
  
  <!-- Tech stack -->
  {techStack && techStack.length > 0 && (
    <div class="mb-6">
      <p class="text-sm text-gray-400 mb-2">Built with:</p>
      <div class="flex flex-wrap gap-2">
        {techStack.map(tech => (
          <span class="text-xs px-3 py-1 bg-dark-panel rounded-full text-neon-cyan border border-neon-cyan/30">
            {tech}
          </span>
        ))}
      </div>
    </div>
  )}
  
  <!-- Links -->
  <div class="flex flex-wrap gap-3">
    {githubUrl && (
      <a 
        href={githubUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="px-6 py-2 bg-neon-green/10 border border-neon-green text-neon-green rounded-full hover:bg-neon-green hover:text-dark-bg transition-all text-sm font-semibold"
      >
        GitHub
      </a>
    )}
    {docsUrl && (
      <a 
        href={docsUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="px-6 py-2 bg-neon-cyan/10 border border-neon-cyan text-neon-cyan rounded-full hover:bg-neon-cyan hover:text-dark-bg transition-all text-sm font-semibold"
      >
        Docs
      </a>
    )}
    {demoUrl && (
      <a 
        href={demoUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="px-6 py-2 bg-neon-purple/10 border border-neon-purple text-neon-purple rounded-full hover:bg-neon-purple hover:text-dark-bg transition-all text-sm font-semibold"
      >
        Demo
      </a>
    )}
  </div>
  
  <!-- Slot for additional content -->
  <div class="mt-6">
    <slot />
  </div>
</div>

<style>
  .product-card {
    animation: fadeIn 0.8s ease-in;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
