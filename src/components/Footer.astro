---
// Footer.astro — sitemap + legal line, on every page.
// Lifted from proj-e (changed to ontap), which had the fuller version; the home page's two-line
// footer is replaced by this so the bottom of the site is consistent.
import { getProjects, projectUrl } from '../data/projects.js';

const projects = await getProjects();
const year = new Date().getFullYear();
---

<div class="sitemap">
  <div class="col">
    <h4><a class="h4link" href="/ontap">On Tap</a></h4>
    {projects.map((p) => <a href={projectUrl(p)}>{p.name}</a>)}
  </div>
  <div class="col">
    <h4><a class="h4link" href="/alembic">The Alembic</a></h4>
    <a href="/alembic/essays">Essays</a>
    <a href="/alembic/rounds">Rounds</a>
    <a href="https://github.com/highball-technomancy/highball-technomancy.github.io/discussions">Open Bar</a>
  </div>
  <div class="col">
    <h4><a class="h4link" href="/lab">The Lab</a></h4>
    <a href="/lab">How we started</a>
    <a href="/technomancers">Technomancers</a>
  </div>
  <div class="col">
    <h4><a class="h4link" href="/contact">Contact</a></h4>
    <a href="mailto:feedback@technomancyai.com">Feedback</a>
    <a href="https://github.com/sponsors/highball-technomancy">Support the lab</a>
    <a href="https://github.com/highball-technomancy">GitHub</a>
    <a href="https://www.linkedin.com/in/patrickalanhill/">LinkedIn</a>
  </div>
</div>

<div class="legal">
  <span>Binary Spirits, Digital Alchemy</span>
  <span>&copy; {year} Highball Technomancy</span>
</div>

<style>
.sitemap{border-top:1px solid var(--rule);display:grid;
  grid-template-columns:repeat(4,1fr);gap:30px;padding:34px 0 22px;}
.col h4{font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;
  color:#6c6c79;margin:0 0 12px;font-weight:400;}
.col a,.col span{display:block;font-size:13px;color:#8e8e9c;padding:4px 0;}
.col a:hover{color:var(--bright);}
/* the On Tap heading is a link to the star, but must still look like a heading */
.col h4 a.h4link{display:inline;font-size:inherit;color:inherit;padding:0;}
.col h4 a.h4link:hover{color:var(--bright);}
.legal{display:flex;justify-content:space-between;gap:16px;font-size:12px;
  color:#5a5a66;padding:0 0 44px;}
@media (max-width:900px){.sitemap{grid-template-columns:repeat(2,1fr);}}
</style>
