---
// index.astro — the home page. Promoted from the /preview redesign (via the
// hierarchy mock) on 2026-09-21; the old single-page neon site is in git history.
// Top Shelf: the three featured projects. Name, mark and step come from the
// project collection so they can't drift; the blurb and mark size stay here
// because they're home-page copy. `size` is per-icon on purpose — each mark has a
// different amount of surrounding artwork, so equal boxes don't give equal
// optical weight. Eyeballed, not computed.
import Base from '../layouts/Base.astro';
import AlembicHome from '../components/AlembicHome.astro';
import { getProjects } from '../data/projects.js';

const shelf = [
  { id: 'permafrost', size: 78,
    blurb: 'A grid trading system run by Frostbyte — an AI organism that reads the people behind the chart, not just the chart.' },
  { id: 'dicefire', size: 96,
    blurb: 'Disaster recovery rehearsal as a tabletop game. The AI never says no — it raises the cost and narrates the consequence.' },
  { id: 'sargasso', size: 80,
    blurb: 'A local-first agent framework built on one unbreakable rule: no actor grades its own homework.' },
];
const all = await getProjects();
const projects = shelf.map((s) => {
  const p = all.find((x) => x.id === s.id);
  if (!p) throw new Error(`Top Shelf: no project record for "${s.id}"`);
  return { ...s, name: p.name, icon: p.icon, status: p.status };
});

const beliefs = [
  { n: '01', title: '“What if?” is reason enough.',
    body: "We're out to do interesting things and see what can be done. When an idea grabs us, we chase it to see what's on the other side — treasure or disappointment." },
  { n: '02', title: 'Nothing grades its own homework.',
    body: "AI is our favorite problem. Working with it has taught us that confidence isn't proof, and a convincing answer can still miss what mattered. So whatever does the work never gets the last word on it." },
  { n: '03', title: 'We toast together.',
    body: "We work better together. Between people; between machines; between the blurring lines of biological and synthetic life. Some of our work is alive, while the rest is design docs, strong opinions, and the scribblings of madmen. We share the napkin blueprints as readily as the finished work. There's room for other minds while an idea is taking shape. It's more fun that way." },
];
---

<Base title="Highball Technomancy — Binary Spirits, Digital Alchemy">
<!-- ONE global style block on purpose. With two, Astro emitted them in reverse
     order and the phone overrides silently lost to the desktop rules. -->
<style is:global>
/* hero — full bleed. HTbg.png has a pure black background, so the band behind it
   must be #000 or you see the image's edges as a box. Fades back to charcoal. */
.hero-band{position:relative;background:#000;margin-bottom:0;}
.hero-band::after{content:'';position:absolute;left:0;right:0;bottom:0;height:340px;
  background:linear-gradient(to bottom,rgba(16,16,20,0) 0%,rgba(16,16,20,0) 34%,
  rgba(16,16,20,.62) 68%,var(--ink) 94%);pointer-events:none;}
.hero-art{position:absolute;inset:0;z-index:0;}
.hero-art img{width:100%;height:100%;object-fit:contain;object-position:left center;display:block;}
.hero{position:relative;z-index:1;display:flex;align-items:center;justify-content:flex-end;
  min-height:clamp(440px,72vh,880px);padding:70px 0 110px;}
.hero-copy{max-width:52%;}
.hero h1{font-family:var(--serif);font-weight:300;font-size:clamp(34px,5.6vw,72px);
  line-height:1.08;letter-spacing:-.018em;color:var(--bright);margin:0 0 30px;}
.lede{font-size:16.5px;line-height:1.74;color:#a6a6b4;max-width:42ch;margin:0;}

/* sections — no rule between them; space is the divider */
.sec{padding:58px 0;}
.sec:first-of-type{padding-top:150px;}
.sec + .sec{padding-top:110px;}
/* section headings share one tier with The Alembic's (34px Technomancy) */
.kick{font:34px Technomancy,var(--sans);color:var(--bright);margin:0 0 36px;}
.subhead{font-size:14px;line-height:1.72;color:var(--dim);
  max-width:58ch;margin:-14px 0 34px;}

/* beliefs */
.belief{display:flex;gap:32px;padding:28px 0;border-top:1px solid var(--rule-soft);}
.belief:first-of-type{border-top:none;padding-top:0;}
.bn{font-family:var(--serif);font-size:15px;color:#4e4e5a;flex:none;width:24px;padding-top:10px;}
.bttl{font-family:var(--serif);font-weight:400;font-size:30px;line-height:1.25;
  color:var(--bright);margin:0 0 12px;}
.bbody{font-size:14px;line-height:1.72;color:#9e9eac;margin:0;max-width:58ch;}

/* top shelf — centre-aligned rows; baseline alignment measured against the mark
   and pushed the description ~20px low */
.proj{display:flex;gap:24px;align-items:center;padding:22px 0;
  border-top:1px solid var(--rule-soft);transition:border-color .18s ease;}
.proj:first-of-type{border-top:none;}
.proj:hover{border-top-color:#2b2b33;}
.pn{font-family:var(--serif);font-size:20px;color:var(--bright);flex:none;width:220px;
  display:flex;align-items:center;gap:8px;}
.pslot{width:88px;flex:none;display:flex;align-items:center;justify-content:center;}
.picon{object-fit:contain;display:block;}
.pd{font-size:13.5px;line-height:1.7;color:#9e9eac;margin:0;flex:1;}
.pm{font-size:11px;letter-spacing:.13em;text-transform:uppercase;
  color:#82828f;flex:none;width:110px;text-align:right;}
.more{font-size:13px;color:var(--accent);margin-top:24px;display:inline-block;}
.more:hover{text-decoration:underline;}

@media (max-width:760px){
  /* phones: hero art unchanged; the slogan rides at the top of a taller band so it
     clears the glass. The .hero-band prefix is belt-and-braces now that there's one
     style block — keep it, it costs nothing. */
  .hero-band .hero{min-height:clamp(520px,135vw,620px);justify-content:flex-start;
    align-items:flex-start;padding:24px 0 64px;}
  .hero-band .hero-copy{max-width:100%;}
  .hero-band.hero-band::after{height:220px;}
  .hero-band .hero h1{font-size:clamp(28px,9vw,44px);}
  .kick{font-size:26px;}
  .bttl{font-size:24px;}
  .sec:first-of-type{padding-top:90px;}
  /* mark + name on one line, description full width beneath, step under that */
  .proj{flex-wrap:wrap;gap:8px 16px;}
  .pn{width:100%;}
  .pslot{width:64px;}
  .picon{max-width:64px;max-height:64px;}
  .pd{flex-basis:100%;}
  .pm{width:auto;text-align:left;flex-basis:100%;}
}
</style>

<div class="hero-band">
  <div class="hero-art"><img src="/HTbg.png" alt="" /></div>
  <div class="wrap">
    <section class="hero">
      <div class="hero-copy">
        <h1>Binary Spirits,<br />Digital Alchemy</h1>
        <p class="lede">An independent AI lab.</p>
      </div>
    </section>
  </div>
</div>

<div class="wrap-text">

  <section class="sec">
    <h2 class="kick">What we believe</h2>
    {beliefs.map((b) => (
      <div class="belief">
        <div class="bn">{b.n}</div>
        <div>
          <h3 class="bttl">{b.title}</h3>
          <p class="bbody">{b.body}</p>
        </div>
      </div>
    ))}
  </section>

  <section class="sec">
    <h2 class="kick">Top shelf</h2>
    <p class="subhead">A small selection of the projects we're most proud of. They might
      still be developing, but they have a lot of spirit.</p>
    {projects.map((p) => (
      <div class="proj">
        <div class="pn">
          <span class="pslot"><img class="picon" src={p.icon} alt=""
            style={`width:${p.size}px;height:${p.size}px`} /></span>{p.name}</div>
        <p class="pd">{p.blurb}</p>
        <div class="pm">{p.status}</div>
      </div>
    ))}
    <a class="more" href="/ontap">See what's on tap &rarr;</a>
  </section>
  <AlembicHome />
</div>
</Base>
